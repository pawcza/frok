# shell.zsh — the shell layer (aliases, fzf, prompt) and the starship prompt.

RC_LINE='[ -r ~/.config/frok/generated/init.sh ] && . ~/.config/frok/generated/init.sh  # frok'

render_shell() {
  local auto=""; [[ $(cfg '.tools | index("autosuggestions")') != "" ]] && auto=$(autosuggest_path)
  {
    print "# generated by frok — don't edit, run \`frok\` instead"
    print "export FROK_HOME='$FROK_HOME'"
    print "export FROK_PROMPT='$(cfg .prompt)'"
    print "export FROK_AUTOSUGGEST='$auto'"
    print "export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=${T[muted]}'"
    print "export BAT_THEME='base16'"
    print "export FZF_DEFAULT_OPTS=\"--height 40% --layout=reverse --border --color=fg:${T[fg]},hl:${T[accent]},fg+:${T[fg]},hl+:${T[a6]},bg+:${T[selection]},pointer:${T[accent2]},marker:${T[a2]},border:${T[border]},prompt:${T[accent]},info:${T[muted]}\""
  } >| $FROK_GEN/env.sh
  print "# generated by frok\n. \"$FROK_HOME/shell/frok.sh\"" >| $FROK_GEN/init.sh

  local rc
  for rc in $HOME/.zshrc $HOME/.bashrc; do
    [[ -f $rc || $rc == $HOME/.zshrc ]] || continue
    grep -qsF 'frok/generated/init.sh' $rc || print "\n$RC_LINE" >> $rc
  done
  # zsh on a fresh Linux box asks the new-user questions once; an rc file stops that
  [[ -f $HOME/.zshrc ]] || print "$RC_LINE" >| $HOME/.zshrc
}

render_starship() {
  [[ $(cfg .prompt) == starship ]] || return 0
  local out=$(<$FROK_HOME/shell/starship.toml.tmpl) k
  for k in ${(k)T}; do out=${out//\{\{$k\}\}/${T[$k]}}; done
  print -r -- "$out" >| $FROK_GEN/starship.toml
}

# Default shell: frok's companion and layouts use zsh; your login shell is yours.
# Switching only changes which rc file runs, so check first that the new shell
# would end up with what the old one sets up (PATH, aliases, functions).
shell_set() {
  local want=$1 bin from=${SHELL:t}
  bin=$(command -v $want) || die "$want isn't installed"
  [[ $from == $want ]] && { say "login shell is already $want"; return }
  if [[ $from == (bash|zsh) && ${2:-} != --force ]]; then
    local gap=$(shell_gap $from $want)
    if [[ -n $gap ]]; then
      shell_gap_report $from $want "$gap"
      [[ -t 0 ]] || die "run \`frok shell port\` first (bash → zsh), or \`frok shell $want --force\` to switch anyway"
      local -a opts=(cancel "switch anyway"); [[ $from == bash && $want == zsh ]] && opts=("port ~/.bashrc into ~/.zshrc" $opts)
      case $(pick "Switch your login shell to $want?" ${opts[1]} $opts) in
        port*) shell_port || return 1
               gap=$(shell_gap bash zsh)
               [[ -z $gap ]] || { shell_gap_report bash zsh "$gap"
                                  [[ $(pick 'Switch anyway?' no yes no) == yes ]] || return 1; } ;;
        cancel) say "login shell stays $from"; return 1 ;;
      esac
    fi
  fi
  grep -qx $bin /etc/shells || print $bin | as_root tee -a /etc/shells >/dev/null
  step "changing your login shell to $want (asks for your password)"
  chsh -s $bin && say "login shell → $want (new terminals)"
}

# shell_probe bash|zsh [own] → "path <dir>" / "cmd <alias or function>" lines for
# what an interactive login shell ends up with. Starts from a bare environment,
# otherwise the PATH frok was started with hides whatever the rc files miss.
# With `own`, only functions defined in your files count (not system or frok ones).
shell_probe() {
  local sh=$1 code
  case $sh in
    bash) code='echo __frok__; tr : "\n" <<<"$PATH" | sed "s/^/path /"; compgen -a | sed "s/^/cmd /"
                shopt -s extdebug; for f in $(compgen -A function); do declare -F "$f"; done |
                while read -r n l s; do [[ -z $FROK_OWN || ( $s == "$HOME"/* && $s != "$FROK_HOME"/* ) ]] && echo "cmd $n"; done' ;;
    zsh)  code='print __frok__; print -l ${${(s.:.)PATH}/#/path } ${${(k)aliases}/#/cmd }
                zmodload zsh/parameter; for n in ${(k)functions}; do s=${functions_source[$n]}
                  [[ -z $FROK_OWN || ( $s == $HOME/* && $s != $FROK_HOME/* ) ]] && print -r -- "cmd $n"; done' ;;
  esac
  local -a tmo; has timeout && tmo=(timeout 20)
  env -i HOME=$HOME USER=$USER LOGNAME=$USER LANG=${LANG:-C.UTF-8} TERM=${TERM:-xterm-256color} \
      SHELL=$(command -v $sh) PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
      FROK_HOME=$FROK_HOME FROK_OWN=${${2:-}:#all} \
      $tmo $sh -lic $code </dev/null 2>/dev/null | sed -n '/^__frok__$/,$p' | sed 1d |
    grep -Ev '^cmd _|^path /mnt/' |
    while read -r kind name; do [[ $kind != path || -d $name ]] && print -r -- "$kind $name"; done | sort -u
}

# shell_gap <from> <to> → what <from> sets up that <to> doesn't have
shell_gap() { comm -23 <(shell_probe $1 own) <(shell_probe $2 all); }

shell_gap_report() {   # shell_gap_report <from> <to> <gap>
  local -a gap=(${(f)3}) p c
  p=(${${(M)gap:#path *}#path }); c=(${${(M)gap:#cmd *}#cmd })
  warn "$2 wouldn't get everything your $1 setup has:"
  (( $#p )) && print -r -- "    PATH:                ${(j:, :)${(@)p/#$HOME/~}}" >&2
  local more=""; (( $#c > 15 )) && more=" … (+$(( $#c - 15 )) more)"
  (( $#c )) && print -r -- "    aliases/functions:   ${(j:, :)c[1,15]}$more" >&2
  (( $#p )) && print -r -- "    (commands in those PATH dirs would be \"not found\" in $2)" >&2
  return 0
}

# frok shell port — rebuild ~/.zshrc from ~/.bashrc. Drops the bash-only bits
# (shopt, PS1/PROMPT_COMMAND, bash-completion), turns `init bash`/`completion bash`/
# `hook bash` into zsh, keeps whatever else was in ~/.zshrc, and backs up the old file.
PORT_MARK='# ── from your previous ~/.zshrc ──'
shell_port() {
  local src=$HOME/.bashrc dst=$HOME/.zshrc
  [[ -f $src ]] || { warn "no ~/.bashrc to port"; return 1 }
  local prev=""
  if [[ -f $dst ]]; then
    if grep -qF "$PORT_MARK" $dst; then prev=$(M=$PORT_MARK awk 'f; $0 == ENVIRON["M"] { f = 1 }' $dst)
    elif grep -qF '# ported from ~/.bashrc by frok' $dst; then prev=""
    else prev=$(<$dst); fi
    prev=$(print -r -- $prev | grep -vF 'frok/generated/init.sh')
  fi
  local tmp=$dst.frok-port
  {
    print "# ported from ~/.bashrc by frok ($(date +%F)) — edit freely."
    print "# \`frok shell port\` rebuilds it from ~/.bashrc; lines under the 'previous ~/.zshrc' mark are kept."
    print 'HISTFILE=~/.zsh_history HISTSIZE=5000 SAVEHIST=5000'
    print 'setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE'
    print 'autoload -Uz compinit && compinit'
    print 'autoload -Uz bashcompinit && bashcompinit   # lets `complete` lines from bash work'
    print
    awk '
      skip == 0 && /^[[:space:]]*if .*shopt/ { skip = 1; depth = 0 }
      skip {
        if ($0 ~ /^[[:space:]]*if[[:space:]]/) depth++
        if ($0 ~ /(^|;)[[:space:]]*fi[[:space:]]*(;|#|$)/) depth--
        if (depth <= 0) skip = 0
        next
      }
      /^[[:space:]]*(shopt|bind)[[:space:]]/ { next }
      /^[[:space:]]*(export[[:space:]]+)?(PS1|PROMPT_COMMAND|HISTCONTROL|HISTFILESIZE)=/ { next }
      /\/usr\/share\/bash-completion|\/etc\/bash_completion/ { next }
      /frok\/generated\/init\.sh/ { next }
      { print }' $src | sed -E 's/\<(init|completion|hook)( -)? bash\>/\1\2 zsh/g'
    if [[ -n ${prev//[[:space:]]/} ]]; then print "\n$PORT_MARK"; print -r -- $prev; fi
    print "\n$RC_LINE"
  } >| $tmp
  local err; err=$(zsh -n $tmp 2>&1) || {
    warn "the ported file doesn't parse in zsh, left ~/.zshrc alone (draft: ${tmp/#$HOME/~}):"
    print -r -- "$err" >&2; return 1; }
  if [[ -f $dst ]]; then local bak=$dst.pre-port.$(date +%Y%m%d-%H%M%S); cp $dst $bak; fi
  mv -f $tmp $dst
  say "~/.zshrc rebuilt from ~/.bashrc${bak:+ (old one: ${bak/#$HOME/~})}"

  # PATH dirs bash gets from places zsh never reads (/etc/profile.d, ~/.profile)
  local -a miss=(${${(M)${(f)"$(shell_gap bash zsh)"}:#path *}#path }) block
  if (( $#miss )); then
    block=("# PATH dirs bash gets from /etc/profile.d or ~/.profile, which zsh doesn't read")
    local d; for d in $miss; do block+=("[[ -d ${(q)d} ]] && path+=(${(q)d})"); done
    B=${(pj:\n:)block} M=$PORT_MARK awk '!done && ($0 == ENVIRON["M"] || index($0, "frok/generated/init.sh")) { print ENVIRON["B"] "\n"; done = 1 } { print }' \
        $dst >| $tmp && mv -f $tmp $dst
    say "added to PATH in ~/.zshrc: ${(j:, :)${(@)miss/#$HOME/~}}"
  fi
  local -a tmo; has timeout && tmo=(timeout 20)
  err=$(env -i HOME=$HOME USER=$USER TERM=${TERM:-xterm-256color} PATH=/usr/local/bin:/usr/bin:/bin \
        $tmo zsh -lic exit </dev/null 2>&1 >/dev/null | grep -v "can't change option: zle")
  [[ -z $err ]] || { warn "zsh printed this while loading the new ~/.zshrc:"; print -r -- "$err" >&2; }
  return 0
}
