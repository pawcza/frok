#!/usr/bin/env zsh
# frok — a terminal upgrade you set up once and steer by asking.
# `frok` alone: the companion in this pane (the step-by-step setup on first run).
# `frok menu`: every setting.
emulate -L zsh
setopt extendedglob pipefail
FROK_HOME=${${0:A}:h:h}
for f in core packages theme keys layout shell agents companion dashboard background fonts \
         terminals/detect terminals/wezterm terminals/windows-terminal terminals/kitty wizard commands; do
  source $FROK_HOME/lib/$f.zsh
done

# ── commands ──────────────────────────────────────────────────────────
cmd=${1:-}; (( $# )) && shift
case $cmd in
  "")
    cfg_init
    [[ $(cfg .configured) == true ]] || { setup; exit }
    { : </dev/tty } 2>/dev/null || { status; print; usage; exit }
    [[ $(cfg .companion) == none ]] && { wz_menu; exit }   # no companion: the menu is the main screen
    companion_run ;;
  menu)
    cfg_init
    { : </dev/tty } 2>/dev/null || { status; print; usage; exit }
    wz_menu ;;
  setup)   setup "$@" ;;
  status)  status "$@" ;;
  apply)   cfg_init; agents_ask ${1-}; apply_all ;;
  doctor)  doctor ;;
  help|-h|--help) usage ;;

  theme)
    if (( ! $# )); then
      local th; for th in $(theme_names); do load_theme $th; printf '  %-18s %s  %s\n' $th "$(swatch)" "${T[name]}"; done
      print "\ncurrent: $(cfg .theme)"
    else theme_file $1 >/dev/null || die "no theme '$1'"; cfg_set .theme "$(jstr $1)"; apply_all; fi ;;

  background|bg)
    case ${1:-} in
      "") print "background: $(cfg .background) (opacity $(cfg .background_opacity))" ;;
      opacity) [[ ${2:-} == (0|1|0.<->|.<->) ]] || die "opacity between 0 and 1"; cfg_set .background_opacity $2; apply_all ;;
      none) cfg_set .background '"none"'; apply_all ;;
      *) if bg_is_effect $1; then cfg_set .background "$(jstr $1)"
         else [[ -f $(expand_home $1) ]] || die "no effect or file '$1' (effects: $(bg_effects | tr '\n' ' '))"
              cfg_set .background "$(jstr ${$(expand_home $1):A})"; fi
         apply_all ;;
    esac ;;

  companion)
    case ${1:-} in
      run) companion_run ;;
      facts) cfg_set .facts $(on_off ${2:-}); say "facts: $(cfg .facts) (restart the companion pane)" ;;
      "") print "companion: $(cfg .companion)  (available: $(companion_names | tr '\n' ' ')none)" ;;
      *) [[ $1 == none || -f $COMPANION_DIR/pets/$1.zsh ]] || die "no companion '$1' (pets: $(companion_names | tr '\n' ' '))"
         cfg_set .companion "$(jstr $1)"; apply_all ;;
    esac ;;

  dashboard) dashboard_cmd "$@" ;;

  layout)
    case ${1:-} in
      "") local l; for l in $(layout_names); do printf '  %-8s %s\n' $l "$(jq -r .about $(layout_file $l))"; done; print "\ncurrent: $(cfg .layout)" ;;
      open)
        if [[ -n $(wt_settings) ]]; then
          local guid=$(jq -r --arg d $WSL_DISTRO_NAME '[.profiles.list[] | select(.name == $d and (.hidden != true)) | .guid][0]' "$(wt_settings)")
          local line=$(wt_layout_cmdline $guid)
          powershell.exe -NoProfile -Command "Start-Process wt.exe -ArgumentList '-w new ${line//\'/\'\'}'" && say "opened '$(cfg .layout)' in a new Windows Terminal window"
        else warn "opening a layout on demand works in Windows Terminal; elsewhere use \`frok layout autostart on\` and restart the terminal"; fi ;;
      autostart) cfg_set .layout_on_start $(on_off ${2:-}); apply_all ;;
      *) layout_file $1 >/dev/null || die "no layout '$1'"; cfg_set .layout "$(jstr $1)"; apply_all ;;
    esac ;;

  agent)   [[ -n ${1:-} ]] && { cfg_set .agent "$(jstr "$*")"; apply_all; } || print "agent: $(cfg .agent)" ;;
  agents)  agents_cmd "$@" ;;
  workdir) [[ -n ${1:-} ]] && { cfg_set .workdir "$(jstr ${1/#$HOME/~})"; apply_all; } || print "workdir: $(cfg .workdir)" ;;
  prompt)  [[ ${1:-} == (starship|none) ]] || die "frok prompt starship|none"; cfg_set .prompt "$(jstr $1)"; apply_all ;;

  font)
    if [[ ${1:-} == size ]]; then [[ ${2:-} == <-> ]] || die "frok font size <n>"; cfg_set .font.size $2
    elif [[ -n ${1:-} ]]; then cfg_set .font.family "$(jstr $1)"; [[ ${2:-} == <-> ]] && cfg_set .font.size $2
    else print "font: $(cfg .font.family) $(cfg .font.size)"; return; fi
    apply_all ;;

  tools)
    case ${1:-} in
      "") local t; for t in ${(f)"$(cfg '.tools[]?')"}; do tool_present $t && print "  ✓ $t" || print "  · $t (not installed)"; done ;;
      install) tools_install; render_shell ;;
      add)    cfg_set .tools "$(jq -c --arg t $2 '(.tools // []) + [$t] | unique' $FROK_CFG)"; tools_install; render_shell ;;
      remove) cfg_set .tools "$(jq -c --arg t $2 '(.tools // []) - [$t]' $FROK_CFG)"; render_shell; say "removed $2 from frok (the package stays installed)" ;;
      *) die "frok tools [install | add <t> | remove <t>]" ;;
    esac ;;

  terminals)
    case ${1:-} in
      "") print "detected: $(terminals_detected | tr '\n' ' ')\nconfigured: $(terminals_active | tr '\n' ' ')" ;;
      auto) cfg_set .terminals '[]'; apply_all ;;
      set) shift; cfg_set .terminals "$(print -l $@ | jq -R . | jq -sc .)"; apply_all ;;
      *) die "frok terminals [set <names…> | auto]" ;;
    esac ;;

  shell)   [[ ${1:-} == port ]] && { shell_port; exit }; shell_set ${1:-zsh} ${2:-} ;;
  update)  git -C $FROK_HOME pull --ff-only && exec $FROK_HOME/bin/frok apply ;;
  uninstall) uninstall ;;
  *) usage; exit 1 ;;
esac
