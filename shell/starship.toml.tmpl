# frok starship template — {{key}} is filled from the active theme.
add_newline = true

format = """
[]({{accent}})\
$directory\
$git_branch\
$git_status\
$nodejs\
$cmd_duration \
$character"""

[character]
success_symbol = "[❯](bold {{a2}})"
error_symbol = "[❯](bold {{a1}})"
vicmd_symbol = "[❮](bold {{a3}})"

[directory]
style = "bg:{{accent}} fg:{{bg}}"
format = "[ $path ]($style)[](fg:{{accent}} bg:{{border}})"
truncation_length = 0          # show the whole path, like Windows
truncate_to_repo = false
read_only = " "

[git_branch]
symbol = " "
style = "bg:{{border}} fg:{{accent2}}"
format = "[ $symbol$branch ]($style)[](fg:{{border}})"

[git_status]
style = "fg:{{a3}}"
format = "[ $all_status$ahead_behind]($style)"
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?${count}"
stashed = "*${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[nodejs]
symbol = " "
style = "fg:{{a2}}"
format = "[ $symbol($version) ]($style)"

[cmd_duration]
min_time = 2000
style = "fg:{{muted}}"
format = "[ took $duration ]($style)"
